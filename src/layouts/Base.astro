---
import '../styles/global.css'
import { NAV, ROOMS, SITE } from '../data/site'

interface Props {
  title: string
  description: string
  image?: string
  noindex?: boolean
  schema?: Record<string, unknown>[]
}
const { title, description, image = '/img/grande.jpg', noindex = false, schema = [] } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL(image, Astro.site).href
const path = Astro.url.pathname

const business = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  '@id': `${SITE.url}/#salon`,
  name: SITE.name,
  legalName: SITE.legal,
  url: SITE.url,
  logo: `${SITE.url}/img/ardor-logo.svg`,
  image: `${SITE.url}/img/grande.jpg`,
  telephone: SITE.phone,
  email: 'info@ardornamjestaj.com',
  foundingDate: String(SITE.founded),
  priceRange: 'KM–KMKM',
  address: { '@type': 'PostalAddress', streetAddress: SITE.street, postalCode: SITE.zip, addressLocality: SITE.city, addressCountry: SITE.country },
  openingHoursSpecification: SITE.hours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })),
  sameAs: [SITE.facebook, SITE.instagram],
}
const ga4 = import.meta.env.PUBLIC_GA4_ID || ''
const pixel = import.meta.env.PUBLIC_META_PIXEL_ID || ''
/** Pregled (npr. GitHub Pages): ne indeksira se, obrasci ne šalju, analitika isključena. */
const preview = import.meta.env.PUBLIC_PREVIEW === '1'
---
<!doctype html>
<html lang="bs" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {(noindex || preview) && <meta name="robots" content="noindex, nofollow">}
  <meta name="theme-color" content="#12100E">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="ARDOR namještaj">
  <meta property="og:locale" content="bs_BA">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&display=swap" rel="stylesheet">
  <link rel="preload" href="/fonts/Ubuntu-R.ttf" as="font" type="font/ttf" crossorigin>
  <script is:inline>
    try { var t = localStorage.getItem('ardor.web.tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <meta name="ardor-ga4" content={ga4}>
  <meta name="ardor-pixel" content={pixel}>
</head>
<body>
<a class="skip" href="#sadrzaj">Preskoči na sadržaj</a>
{preview && <div class="preview-bar">Pregled nove web stranice ARDOR-a · obrasci ne šalju upite · fotografije i cijene su primjeri</div>}

<header class="nav" id="nav">
  <div class="wrap">
    <a href="/" aria-label="ARDOR — početna"><img class="logo logo-dark" src="/img/ardor-logo-negativ.svg" alt="ARDOR namještaj" width="140" height="34"><img class="logo logo-light" src="/img/ardor-logo.svg" alt="ARDOR namještaj" width="140" height="34"></a>
    <ul id="menu">
      {NAV.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
    <button class="icon-btn" id="themeBtn" aria-label="Svijetla ili tamna tema" title="Svijetla / tamna tema">
      <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    <a class="btn btn-primary btn-cta" href="/kontakt/?vrsta=ponuda">Besplatna ponuda</a>
    <button class="icon-btn burger" id="burger" aria-label="Otvori meni" aria-controls="menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  </div>
</header>

<main id="sadrzaj">
  <slot />
</main>

<footer class="site">
  <div class="wrap">
    <div class="foot-big">Uredimo tvoj dom.<br><a href={SITE.phoneHref} data-ev="poziv">051 433 750</a></div>
    <div class="foot-cols">
      <div>
        <img src="/img/ardor-logo-negativ.svg" alt="ARDOR" style="height:30px;margin-bottom:18px" class="logo-dark" width="124" height="30">
        <p style="color:var(--muted);font-size:14px;max-width:320px">{SITE.legal} — salon namještaja i proizvodnja namještaja po mjeri. {SITE.street}, {SITE.city}.<br>Radni dan {SITE.hours[0].value}, subota {SITE.hours[1].value}.</p>
      </div>
      <div><h4>Namještaj</h4>{ROOMS.slice(0, 6).map((r) => <a href={`/namjestaj/${r.key}/`}>{r.name}</a>)}</div>
      <div><h4>ARDOR</h4><a href="/namjestaj-po-mjeri/">Namještaj po mjeri</a><a href="/namjestaj-po-mjeri/kuhinje/">Kuhinje po mjeri</a><a href="/namjestaj-po-mjeri/ugradbeni-plakari/">Ugradbeni plakari</a><a href="/savjetnik/">AI savjetnik</a><a href="/placanje-na-rate/">Plaćanje na rate</a><a href="/o-nama/">O nama</a></div>
      <div><h4>Kontakt</h4><a href="/kontakt/">Kontakt i salon</a><a href={SITE.facebook} target="_blank" rel="noopener">Facebook</a><a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a><a href="/privatnost/">Privatnost</a><a href="/kolacici/">Kolačići</a><a href="#" id="cookieSettings">Postavke kolačića</a></div>
    </div>
    <div class="foot-bottom"><span>© {new Date().getFullYear()} {SITE.legal} · Banja Luka</span><span>Cijene uključuju PDV 17 %</span></div>
  </div>
</footer>

<div class="fab" id="fab">
  <button class="fab-main" id="fabBtn" aria-label="Brzi kontakt" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
  <a class="fab-item" href={SITE.phoneHref} data-ev="poziv"><span>Nazovi salon</span><i style="background:#58595B"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></i></a>
  <a class="fab-item" href={SITE.viber} data-ev="viber"><span>Viber</span><i style="background:#7360F2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c5 0 8 2.5 8 7.5S17 18 12 18l-4 3v-3.5C5.5 16.5 4 14 4 10.5 4 5.5 7 3 12 3z"/></svg></i></a>
  <a class="fab-item" href={SITE.whatsapp} target="_blank" rel="noopener" data-ev="whatsapp"><span>WhatsApp</span><i style="background:#25D366"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"/><path d="M9 9.5c.5 2 2.5 4 4.5 4.5l1-1 1.5.8"/></svg></i></a>
</div>

<div class="cookies" id="cookies" role="dialog" aria-label="Kolačići">
  <b>Kolačići</b>
  <p>Koristimo nužne kolačiće da stranica radi, a uz tvoju dozvolu i analitičke (Google Analytics 4) i marketinške (Meta Pixel). <a href="/kolacici/">Više</a></p>
  <div class="row"><button class="btn btn-primary" data-c="sve">Prihvati sve</button><button class="btn btn-ghost" data-c="nuzni">Samo nužni</button></div>
</div>

<script>
  import { initSite } from '../scripts/site'
  initSite()
</script>
</body>
</html>
