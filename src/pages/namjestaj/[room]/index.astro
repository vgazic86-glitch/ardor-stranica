---
import Base from '../../../layouts/Base.astro'
import Catalog from '../../../components/Catalog.astro'
import CtaBand from '../../../components/CtaBand.astro'
import { ROOMS, type Room } from '../../../data/site'
import { getCatalog } from '../../../data/catalog'
export function getStaticPaths() { return ROOMS.map((r) => ({ params: { room: r.key }, props: { room: r } })) }
const { room } = Astro.props as { room: Room }
const { products } = await getCatalog()
const list = products.filter((p) => p.room === room.key)
const custom = ['kuhinja', 'ormari-i-plakari', 'hodnik'].includes(room.key)
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: room.guide.map((g) => ({ '@type': 'Question', name: g.q, acceptedAnswer: { '@type': 'Answer', text: g.a } })) }
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Početna', item: 'https://www.ardornamjestaj.com/' }, { '@type': 'ListItem', position: 2, name: 'Katalog', item: 'https://www.ardornamjestaj.com/namjestaj/' }, { '@type': 'ListItem', position: 3, name: room.name }] }
---
<Base title={room.title} description={room.description} image={room.img ? `/img/${room.img}.jpg` : undefined} schema={[faq, crumbs]}>
  {room.img ? (
    <section class="hero short">
      <div class="hero-media"><img src={`/img/${room.img}.jpg`} alt={room.name} style={room.imgPos ? `object-position:${room.imgPos}` : undefined}></div>
      <div class="wrap">
        <nav class="crumbs" aria-label="Putanja"><a href="/">Početna</a><span><a href="/namjestaj/">Katalog</a></span><span>{room.name}</span></nav>
        <div class="eyebrow">{room.name}</div>
        <h1>{room.h1}</h1>
        <p class="hero-sub">{room.intro}</p>
      </div>
    </section>
  ) : (
    <section class="page-head"><div class="wrap">
      <nav class="crumbs" aria-label="Putanja"><a href="/">Početna</a><span><a href="/namjestaj/">Katalog</a></span><span>{room.name}</span></nav>
      <div class="eyebrow">{room.name}</div><h1>{room.h1}</h1><p class="lead">{room.intro}</p>
    </div></section>
  )}
  <section class="sec-tight"><div class="wrap">
    {list.length ? <Catalog products={list} roomFilter={false} /> : (
      <div class="empty">Ovu kategoriju upravo osvježavamo na webu. Pogledaj je uživo u salonu ili zatraži ponudu — {custom ? 'radimo i po mjeri.' : 'javljamo se isti dan.'}<br><br><a class="btn btn-primary" href={`/kontakt/?vrsta=ponuda`}>Zatraži ponudu</a></div>
    )}
  </div></section>
  <section class="sec-tight" style="padding-top:0"><div class="wrap grid-2" style="align-items:start">
    <div><div class="eyebrow">Vodič za kupce</div><h2>Prije nego odabereš</h2></div>
    <div class="faq">{room.guide.map((g, i) => <details open={i === 0}><summary>{g.q}</summary><p>{g.a}</p></details>)}</div>
  </div></section>
  {custom
    ? <CtaBand title="Napravimo po tvojoj mjeri." text="Besplatno mjerenje, 3D prijedlog i montaža iz našeg pogona u Banjoj Luci." primary={['Zakaži besplatno mjerenje', '/kontakt/?vrsta=mjerenje']} secondary={['Kako radimo', '/namjestaj-po-mjeri/']} />
    : <CtaBand />}
</Base>
